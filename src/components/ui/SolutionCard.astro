---
import orbit from '../../assets/images/solutions-orbit.svg';

interface Props {
  image: any;
  title: string;
}

const { image, title } = Astro.props;
---

<article class="solution-card">
  <div class="solution-card__visual">
    <div
      class="solution-card__photo"
      style={`--orbit: url(${orbit.src})`}
    >
      <img src={image.src} alt={`${title} illustration`} loading="lazy" />
    </div>
  </div>

  <h3 class="solution-card__title">{title}</h3>
</article>