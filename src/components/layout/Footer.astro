---
import Logo from '../ui/Logo.astro';
import Youtube from '../../assets/icons/socials/youtube.svg';
import Discord from '../../assets/icons/socials/discord.svg';
import LinkedIn from '../../assets/icons/socials/in.svg';

const footerLinks = [
  { label: 'Products', href: '/products' },
  { label: 'Assets', href: '/assets' },
  { label: 'Support', href: '/support' },
  { label: 'About', href: '/about' },
];

const socials = [
  { Component: Youtube, href: 'https://youtube.com', label: 'YouTube' },
  { Component: Discord, href: 'https://discord.com', label: 'Discord' },
  { Component: LinkedIn, href: 'https://linkedin.com', label: 'LinkedIn' },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__container">
    <!-- Бренд -->
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="FlexUI — Home">
        <Logo class="footer__logo-icon" size={32} />
        <span class="footer__logo-text">FlexUI</span>
      </a>
      <span class="footer__tagline">Full-Service Webflow Agency</span>
    </div>

    <!-- Навигация -->
    <nav class="footer__nav" aria-label="Footer navigation">
      <ul class="footer__nav-list">
        {footerLinks.map((link) => (
          <li>
            <a href={link.href} class="footer__nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Соцсети -->
    <div class="footer__socials">
      <p class="footer__socials-title">Social Links:</p>
      <ul class="footer__socials-list">
        {socials.map(({ Component, href, label }) => (
          <li>
            <a
              href={href}
              class="footer__social-link"
              aria-label={label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Component />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Нижняя полоса -->
  <div class="footer__bottom">
    <div class="footer__bottom-container">
      <p class="footer__copyright">
        {currentYear} FlexUI. All Rights Reserved
      </p>
      <ul class="footer__legal">
        <li><a href="/privacy" class="footer__legal-link">Privacy Policy</a></li>
        <li><a href="/terms" class="footer__legal-link">Term of Use</a></li>
      </ul>
    </div>
  </div>
</footer>