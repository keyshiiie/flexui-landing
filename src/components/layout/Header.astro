---
import Logo from '../ui/Logo.astro';

const navItems = [
  {
    label: 'Products',
    href: '/products',
    children: [
      { label: 'SaaS Solutions', href: '/products/saas' },
      { label: 'Webflow Templates', href: '/products/templates' },
      { label: 'UI Kits', href: '/products/ui-kits' },
    ],
  },
  {
    label: 'Assets',
    href: '/assets',
    children: [
      { label: 'Blog', href: '/assets/blog' },
      { label: 'Case Studies', href: '/assets/cases' },
      { label: 'Guides', href: '/assets/guides' },
    ],
  },
  {
    label: 'Support',
    href: '/support',
    children: [
      { label: 'FAQ', href: '/support/faq' },
      { label: 'Contact Support', href: '/support/contact' },
      { label: 'System Status', href: '/support/status' },
    ],
  },
  {
    label: 'Company',
    href: '/company',
    children: [
      { label: 'About Us', href: '/company/about' },
      { label: 'Team', href: '/company/team' },
      { label: 'Careers', href: '/company/careers' },
      { label: 'Contacts', href: '/company/contacts' },
    ],
  },
  { label: 'About', href: '/about', children: null },
];

const arrowIcon = `
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M19.5 8.25L12 15.75L4.5 8.25" stroke="#191919" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
`;
---

<header class="header" data-header>
  <div class="header__container">
    <!-- Логотип -->
    <a href="/" class="header__logo" aria-label="FlexUI — Home">
      <Logo class="header__logo-icon" size={39} />
      <span class="header__logo-text">FlexUI</span>
    </a>

    <!-- Навигация (десктоп) -->
    <nav class="header__nav" aria-label="Main navigation">
      <ul class="header__nav-list">
        {navItems.map((item) => (
          <li class="header__nav-item">
            <a href={item.href} class="header__nav-link">
              {item.label}
              {item.children && (
                <span class="header__nav-arrow" set:html={arrowIcon}></span>
              )}
            </a>

            {item.children && (
              <ul class="header__dropdown">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="header__dropdown-link">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Кнопки справа (десктоп) -->
    <div class="header__actions">
      <a href="/how-it-works" class="header__link">How it Work</a>
      <a href="/contact" class="header__cta">Contact Us</a>
    </div>

    <!-- Бургер -->
    <button
      class="header__burger"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-burger
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- ================= МОБИЛЬНОЕ МЕНЮ ================= -->
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
    <div class="mobile-menu__overlay" data-mobile-overlay></div>

    <div class="mobile-menu__panel">
      <nav class="mobile-menu__nav" aria-label="Mobile navigation">
        <ul class="mobile-menu__list">
          {navItems.map((item) => (
            <li class="mobile-menu__item">
              {item.children ? (
                <>
                  <button
                    class="mobile-menu__toggle"
                    type="button"
                    aria-expanded="false"
                    data-accordion
                  >
                    <span>{item.label}</span>
                    <span class="mobile-menu__arrow" set:html={arrowIcon}></span>
                  </button>

                  <ul class="mobile-menu__submenu">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="mobile-menu__submenu-link">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a href={item.href} class="mobile-menu__link">
                  {item.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-menu__actions">
        <a href="/how-it-works" class="mobile-menu__link">How it Work</a>
        <a href="/contact" class="header__cta mobile-menu__cta">Contact Us</a>
      </div>
    </div>
  </div>
</header>