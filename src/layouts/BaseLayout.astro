---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/inter/900.css';

import '../styles/main.scss';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FlexUI — Full-Service Webflow Agency',
  description = 'A dedicated Webflow agency that builds responsive, visually stunning websites for modern digital solutions.',
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import { initAnimations } from '../scripts/animations.js';
      import { initReviewsSlider } from '../scripts/slider.js';
      import { initMobileMenu } from '../scripts/mobile-menu.js';

      // Инициализация после того, как DOM готов
      initReviewsSlider();
      initAnimations();
      initMobileMenu();
    </script>
  </body>
</html>