---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/inter/900.css';

import '../styles/main.scss';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string; // Для OG-картинки
}

const {
  title = 'FlexUI — Full-Service Webflow Agency',
  description = 'A dedicated Webflow agency that builds responsive, visually stunning websites for modern digital solutions.',
  image = '/og-image.jpg', // Картинка по умолчанию в папке public
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Канонический URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    
    <!-- Open Graph (для соцсетей) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />

    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import { initAnimations } from '../scripts/animations.js';
      import { initReviewsSlider } from '../scripts/slider.js';
      import { initMobileMenu } from '../scripts/mobile-menu.js';

      initReviewsSlider();
      initAnimations();
      initMobileMenu();
    </script>
  </body>
</html>